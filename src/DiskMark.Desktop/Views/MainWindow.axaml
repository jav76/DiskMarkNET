<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:DiskMark.Desktop.ViewModels"
        xmlns:views="using:DiskMark.Desktop.Views"
        xmlns:hw="clr-namespace:DiskMark.Core.Hardware;assembly=DiskMark.Core"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="780"
        x:Class="DiskMark.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="DiskMarkNET"
        Width="1200" Height="780" MinWidth="960" MinHeight="620"
        TransparencyLevelHint="AcrylicBlur"
        Background="Transparent">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Border x:Name="RootBorder" Padding="16">
        <Grid RowDefinitions="Auto,Auto,*,Auto">

            <!-- Toolbar: run controls, target, and settings -->
            <Border Classes="card" Grid.Row="0">
                <Grid ColumnDefinitions="Auto,*">
                    <StackPanel Spacing="8" VerticalAlignment="Center" Margin="0,0,16,0">
                        <Button Classes="accent" Content="Start" Width="96" HorizontalContentAlignment="Center"
                                Command="{Binding StartCommand}" />
                        <Button Content="Stop" Width="96" HorizontalContentAlignment="Center"
                                Command="{Binding StopCommand}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="10">
                        <Grid ColumnDefinitions="Auto,260,*,Auto,Auto">
                            <TextBlock Classes="caption" Text="TARGET" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" IsEnabled="{Binding IsIdle}"
                                      ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="hw:StorageTarget">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding DisplayName}" />
                                            <TextBlock Classes="muted" Text="{Binding FileSystemType}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBox Grid.Column="2" Margin="8,0,0,0" IsEnabled="{Binding IsIdle}"
                                     Text="{Binding TargetDirectory}" PlaceholderText="Directory to test in" />
                            <Button Grid.Column="3" Margin="8,0,0,0" Content="Browse..." IsEnabled="{Binding IsIdle}"
                                    Command="{Binding BrowseCommand}" />
                            <Button Grid.Column="4" Margin="8,0,0,0" Content="Save JSON"
                                    Command="{Binding SaveJsonCommand}" />
                        </Grid>

                        <WrapPanel>
                            <views:LabeledSetting Label="PROFILE">
                                <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" IsEnabled="{Binding IsIdle}" MinWidth="110" />
                            </views:LabeledSetting>
                            <views:LabeledSetting Label="SIZE">
                                <ComboBox ItemsSource="{Binding FileSizes}" SelectedItem="{Binding SelectedFileSize}" IsEnabled="{Binding IsIdle}" MinWidth="110" />
                            </views:LabeledSetting>
                            <views:LabeledSetting Label="PASSES">
                                <ComboBox ItemsSource="{Binding PassOptions}" SelectedItem="{Binding SelectedPasses}" IsEnabled="{Binding IsIdle}" MinWidth="70" />
                            </views:LabeledSetting>
                            <views:LabeledSetting Label="DURATION">
                                <ComboBox ItemsSource="{Binding DurationOptions}" SelectedItem="{Binding SelectedDuration}" IsEnabled="{Binding IsIdle}" MinWidth="80" />
                            </views:LabeledSetting>
                            <views:LabeledSetting Label="INTERVAL">
                                <ComboBox ItemsSource="{Binding IntervalOptions}" SelectedItem="{Binding SelectedInterval}" IsEnabled="{Binding IsIdle}" MinWidth="80" />
                            </views:LabeledSetting>
                            <views:LabeledSetting Label="MODE">
                                <ComboBox ItemsSource="{Binding ModeOptions}" SelectedItem="{Binding SelectedMode}" IsEnabled="{Binding IsIdle}" MinWidth="130" />
                            </views:LabeledSetting>
                            <views:LabeledSetting Label="UNIT">
                                <ComboBox ItemsSource="{Binding UnitOptions}" SelectedItem="{Binding SelectedUnit}" MinWidth="90" />
                            </views:LabeledSetting>
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Status and progress -->
            <StackPanel Grid.Row="1" Margin="4,12,4,12" Spacing="6">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Classes="mono" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}" Text="{Binding LiveRateText}" />
                </Grid>
                <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}" Height="6" MinHeight="6" />
                <TextBlock Classes="warning" Text="{Binding Drive.Warning}"
                           IsVisible="{Binding Drive.Warning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>

            <!-- Score matrix and telemetry -->
            <Grid Grid.Row="2" ColumnDefinitions="440,*">
                <Border Classes="card" Margin="0,0,12,0">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" ColumnDefinitions="100,*,*" Margin="0,0,0,10">
                            <TextBlock Classes="caption" Text="{Binding UnitLabel}" VerticalAlignment="Bottom" />
                            <TextBlock Grid.Column="1" Classes="caption" Text="READ" HorizontalAlignment="Right" Margin="0,0,14,0" />
                            <TextBlock Grid.Column="2" Classes="caption" Text="WRITE" HorizontalAlignment="Right" Margin="0,0,14,0" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:BenchmarkItemViewModel">
                                    <Grid ColumnDefinitions="100,*,*" Margin="0,0,0,10">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" />
                                            <TextBlock Classes="muted" Text="{Binding Subtitle}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Margin="0,0,8,0" Classes="cell read"
                                                Classes.active="{Binding IsReadActive}"
                                                Command="{Binding SelectReadCommand}"
                                                Content="{Binding ReadText}"
                                                ToolTip.Tip="Show read latency" />
                                        <Button Grid.Column="2" Classes="cell write"
                                                Classes.active="{Binding IsWriteActive}"
                                                Command="{Binding SelectWriteCommand}"
                                                Content="{Binding WriteText}"
                                                ToolTip.Tip="Show write latency" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>

                <Border Grid.Column="1" Classes="card" Padding="6">
                    <views:DashboardTabs />
                </Border>
            </Grid>

            <!-- Run warnings -->
            <ItemsControl Grid.Row="3" Margin="4,10,4,0" ItemsSource="{Binding Warnings}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <TextBlock Classes="warning" Text="{Binding StringFormat=⚠ {0}}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Border>
</Window>
